---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import Preloader from '../components/Preloader.astro';
import { company } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	intro?: boolean;
}

const {
	title = `${company.name} | General contractor in Metro Manila`,
	description = company.description,
	intro = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#121314" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline define:vars={{ intro }}>
			// `.js` enables the hidden "before" states of the entrance animations.
			// `.is-loading` shows the short intro once per session (never with reduced motion).
			// Fail-safe: if the motion script has not started within 3s, drop both so
			// every element shows in its final state.
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				var seen = false;
				try {
					seen = sessionStorage.getItem('haligi-intro') === '1';
				} catch (e) {}
				var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (intro && !seen && !calm) root.classList.add('is-loading');
				setTimeout(function () {
					if (!root.classList.contains('motion-ready')) root.classList.remove('js', 'is-loading');
				}, 3000);
			})();
		</script>
	</head>
	<body>
		{intro && <Preloader />}
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<BackToTop />
		<script>
			import '../scripts/main';
		</script>
	</body>
</html>
