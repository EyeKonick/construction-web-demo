---
import Icon from './Icon.astro';
import { budgets, company, projectTypes } from '../data/site';

// Optional form backend (Formspree, Web3Forms, Basin, your own API…).
// Without it the form validates, then opens a pre-filled email to the company.
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
	<div class="wrap">
		<div class="ruler" aria-hidden="true" data-reveal="rule"></div>
		<div class="contact__grid">
			<div class="contact__intro">
				<p class="label mono" data-reveal><span>08</span> Request a quote</p>
				<h2 class="h2 lines" id="contact-title" data-reveal="lines">
					<span class="ln"><span style="--l:0">Tell us what</span></span>
					<span class="ln dim"><span style="--l:1">you need built.</span></span>
				</h2>
				<p data-reveal style="--i:2">
					Send the location, the size and your timeline. An estimator replies within two working days, and the site
					visit and first estimate are free.
				</p>
				<dl class="contact__details" data-reveal style="--i:3">
					<div>
						<dt class="mono">Email</dt>
						<dd><a class="u-link" href={`mailto:${company.email}`}>{company.email}</a></dd>
					</div>
					<div>
						<dt class="mono">Office</dt>
						<dd>{company.office}</dd>
					</div>
					<div>
						<dt class="mono">Hours</dt>
						<dd>{company.hours}</dd>
					</div>
					<div>
						<dt class="mono">We build in</dt>
						<dd>Metro Manila, Calabarzon and Central Luzon</dd>
					</div>
				</dl>
			</div>

			<div class="contact__form-wrap" data-reveal style="--i:1">
				<form
					class="form"
					novalidate
					data-contact-form
					data-endpoint={endpoint}
					data-email={company.email}
					aria-describedby="form-status"
				>
					<div class="field field--half">
						<label for="cf-name">Your name</label>
						<input id="cf-name" name="name" type="text" autocomplete="name" required minlength="2" aria-describedby="cf-name-error" />
						<span class="field__error" id="cf-name-error"></span>
					</div>

					<div class="field field--half">
						<label for="cf-email">Email address</label>
						<input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-error" />
						<span class="field__error" id="cf-email-error"></span>
					</div>

					<div class="field field--half">
						<label for="cf-type">Project type</label>
						<select id="cf-type" name="projectType" required aria-describedby="cf-type-error">
							<option value="" selected disabled>Choose one</option>
							{projectTypes.map((t) => <option value={t}>{t}</option>)}
						</select>
						<span class="field__error" id="cf-type-error"></span>
					</div>

					<div class="field field--half">
						<label for="cf-location">Site location <span class="muted">(optional)</span></label>
						<input id="cf-location" name="location" type="text" autocomplete="address-level2" placeholder="City or municipality" />
						<span class="field__error"></span>
					</div>

					<div class="field">
						<label for="cf-budget">Construction budget <span class="muted">(optional)</span></label>
						<div class="chips" role="radiogroup" aria-label="Construction budget">
							{
								budgets.map((b, i) => (
									<label class="chip">
										<input type="radio" name="budget" value={b} id={i === 0 ? 'cf-budget' : undefined} />
										<span>{b}</span>
									</label>
								))
							}
						</div>
						<span class="field__error"></span>
					</div>

					<div class="field">
						<label for="cf-message">About the project</label>
						<textarea
							id="cf-message"
							name="message"
							rows="4"
							required
							minlength="20"
							maxlength="2000"
							placeholder="Lot size, number of floors, target start date, drawings you already have"
							aria-describedby="cf-message-error"></textarea>
						<span class="field__error" id="cf-message-error"></span>
					</div>

					<div class="field field--hp" aria-hidden="true">
						<label for="cf-company">Leave this field empty</label>
						<input id="cf-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
					</div>

					<div class="field field--check">
						<input id="cf-consent" name="consent" type="checkbox" required aria-describedby="cf-consent-error" />
						<label for="cf-consent">I agree that {company.name} may store these details to reply to my request.</label>
						<span class="field__error" id="cf-consent-error"></span>
					</div>

					<div class="form__footer">
						<p class="form__status" id="form-status" role="status" aria-live="polite" data-form-status></p>
						<button class="btn btn--accent" type="submit" data-submit data-magnetic>
							<span class="btn__label" data-text="Send the request">Send the request</span>
							<span class="btn__icon">
								<span class="btn__arrow"><Icon name="arrow-right" /></span>
								<span class="spinner" aria-hidden="true"></span>
							</span>
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</section>
