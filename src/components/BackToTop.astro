---
import Icon from './Icon.astro';
---

<button class="to-top" type="button" aria-label="Back to top" data-to-top>
	<svg class="to-top__ring" viewBox="0 0 56 56" aria-hidden="true">
		<rect class="track" x="1" y="1" width="54" height="54"></rect>
		<rect class="bar" x="1" y="1" width="54" height="54" pathLength="100"></rect>
	</svg>
	<Icon name="arrow-up" class="to-top__arrow" />
</button>
